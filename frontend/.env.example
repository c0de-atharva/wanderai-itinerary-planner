# Frontend Environment Variables - SAFE TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control!

# --- Backend API URL ---
VITE_API_BASE_URL=http://localhost:8000

# --- Supabase (Optional - app works without these in Demo Mode) ---
# Get from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
